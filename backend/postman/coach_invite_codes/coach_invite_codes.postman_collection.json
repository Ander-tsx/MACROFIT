{
  "info": {
    "name": "MacroFit · CoachInviteCodes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "HU-12 Código de invitación",
      "item": [
        {
          "name": "01 - Primera consulta (Coach)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{coach_access_token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/coach/invite-code",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "coach", "invite-code"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "  pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "  });",
                  "  const data = pm.response.json();",
                  "  pm.test('Responde { code } de 6 caracteres A-Z0-9', function () {",
                  "    pm.expect(data).to.have.property('code');",
                  "    pm.expect(data.code).to.match(/^[A-Z0-9]{6}$/);",
                  "  });",
                  "  pm.collectionVariables.set('coach_invite_code', data.code);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Segunda consulta (Mismo código)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{coach_access_token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/coach/invite-code",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "coach", "invite-code"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "  pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "  });",
                  "  const data = pm.response.json();",
                  "  pm.test('Devuelve el mismo código que la primera consulta', function () {",
                  "    pm.expect(data.code).to.eql(pm.collectionVariables.get('coach_invite_code'));",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - Regenerar código",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{coach_access_token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/coach/invite-code/regenerate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "coach", "invite-code", "regenerate"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "  pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "  });",
                  "  const data = pm.response.json();",
                  "  const previous = pm.collectionVariables.get('coach_invite_code');",
                  "  pm.collectionVariables.set('coach_previous_invite_code', previous);",
                  "  pm.collectionVariables.set('coach_invite_code', data.code);",
                  "  pm.test('El nuevo código tiene formato válido', function () {",
                  "    pm.expect(data.code).to.match(/^[A-Z0-9]{6}$/);",
                  "  });",
                  "  pm.test('El nuevo código es distinto del anterior', function () {",
                  "    pm.expect(data.code).to.not.eql(previous);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "04 - Consulta con cuenta de usuario",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{user_access_token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/coach/invite-code",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "coach", "invite-code"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "  pm.test('Status 403 Forbidden', function () {",
                  "    pm.response.to.have.status(403);",
                  "  });",
                  "  pm.test('error.code == FORBIDDEN_ROLE', function () {",
                  "    pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN_ROLE');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    { "key": "coach_invite_code", "value": "" },
    { "key": "coach_previous_invite_code", "value": "" }
  ]
}
