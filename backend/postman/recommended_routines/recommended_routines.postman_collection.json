        {
          "name": "01 - Principiante con 3 días: cuerpo completo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "    pm.test(\"Status 201 Created\", function () {",
                  "        pm.response.to.have.status(201);",
                  "    });",
                  "    const data = pm.response.json();",
                  "    pm.test(\"Rutina con origen system y los datos del perfil\", function () {",
                  "        pm.expect(data.id).to.match(/^[0-9a-f]{24}$/);",
                  "        pm.expect(data.origin).to.eql(\"system\");",
                  "        pm.expect(data.objective).to.eql(\"lose_fat\");",
                  "        pm.expect(data.level).to.eql(\"beginner\");",
                  "        pm.expect(data.training_days).to.eql(3);",
                  "        pm.expect(data.name).to.be.a(\"string\").and.include(\"Rutina recomendada\");",
                  "        pm.expect(data.created_at).to.be.a(\"string\").and.not.empty;",
                  "        pm.expect(data).to.not.have.property(\"user_id\");",
                  "        pm.expect(data).to.not.have.property(\"status\");",
                  "    });",
                  "    pm.test(\"Una sesión por día de entrenamiento, numeradas desde 1 (RF-14)\", function () {",
                  "        pm.expect(data.sessions).to.be.an(\"array\").with.lengthOf(3);",
                  "        data.sessions.forEach(function (s, i) {",
                  "            pm.expect(s.number).to.eql(i + 1);",
                  "            pm.expect(s.name).to.match(new RegExp(\"^Día \" + (i + 1) + \" · \"));",
                  "        });",
                  "        pm.expect(data.sessions.map(function (s) { return s.focus; })).to.eql([\"full_body\",\"full_body\",\"full_body\"]);",
                  "    });",
                  "    pm.test(\"Ejercicios con series, repeticiones y descanso del nivel y objetivo\", function () {",
                  "        data.sessions.forEach(function (s) {",
