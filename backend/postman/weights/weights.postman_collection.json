            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "    pm.test(\"Status 201 Created\", function () {",
                  "        pm.response.to.have.status(201);",
                  "    });",
                  "    const data = pm.response.json();",
                  "    pm.test(\"Estructura: id, user_id, weight_kg, recorded_at\", function () {",
                  "        pm.expect(data).to.have.all.keys(\"id\", \"user_id\", \"weight_kg\", \"recorded_at\");",
                  "        pm.expect(data.id).to.be.a(\"string\").and.to.match(/^[0-9a-f]{24}$/);",
                  "        pm.expect(Date.parse(data.recorded_at)).to.not.be.NaN;",
                  "    });",
                  "    pm.test(\"Guarda el peso enviado, del usuario de la sesión y con la fecha del servidor\", function () {",
                  "        pm.expect(data.weight_kg).to.eql(Number(pm.collectionVariables.get(\"weights_first_kg\")));",
                  "        pm.expect(data.user_id).to.eql(pm.collectionVariables.get(\"weights_user_id\"));",
                  "        pm.expect(Math.abs(Date.now() - Date.parse(data.recorded_at))).to.be.below(5 * 60 * 1000);",
                  "    });",
                  "    pm.collectionVariables.set(\"weights_first_id\", data.id);",
                  "}"
                ]
              }
            }
          ],
