# MongoDB Atlas o MongoDB Local
# Ejemplo Atlas: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?appName=MacroFit
MONGO_URI=mongodb://localhost:27017
DB_NAME=macrofit_db
JWT_SECRET=tu_clave_secreta_super_segura
PORT=3000
# development habilita las rutas de datos de prueba (/api/v1/dev); omítela en producción
APP_ENV=development
# Duración de los tokens (opcionales)
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# ── Reconocimiento de alimentos (TEC-02 / HU-07) ──
# Proveedor: simulator (por defecto, sin red) | logmeal | gemini | gemini_fatsecret
FOOD_PROVIDER=simulator
# Tiempo de espera con el proveedor, de 1 a 10 s (RNF-01)
FOOD_PROVIDER_TIMEOUT_SECS=10
# Respuesta del simulador: ok | not_recognized | error | timeout
FOOD_SIMULATOR_MODE=ok
# Solo se exigen las credenciales del proveedor elegido. Nunca las subas ni las pegues en Postman o en un chat.
# LogMeal: token de un APIUser (no el APICompany del panel)
LOGMEAL_API_TOKEN=
# Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# FatSecret Platform (OAuth 2.0 client credentials; registra tu IP pública en su consola)
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=