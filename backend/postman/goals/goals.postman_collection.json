        {
          "name": "04 - Meta recalculada",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "    pm.test(\"Status 200 OK\", function () {",
                  "        pm.response.to.have.status(200);",
                  "    });",
                  "    const data = pm.response.json();",
                  "    pm.test(\"Estructura: id, user_id, calories, protein_g, fat_g, source, set_by, effective_from, created_at\", function () {",
                  "        pm.expect(data).to.have.all.keys(\"id\", \"user_id\", \"calories\", \"protein_g\", \"fat_g\", \"source\", \"set_by\", \"effective_from\", \"created_at\");",
                  "        pm.expect(data.id).to.be.a(\"string\").and.to.match(/^[0-9a-f]{24}$/);",
                  "        pm.expect(data.calories).to.be.a(\"number\");",
                  "        pm.expect(data.protein_g).to.be.a(\"number\");",
                  "        pm.expect(data.fat_g).to.be.a(\"number\");",
                  "        pm.expect(Date.parse(data.effective_from)).to.not.be.NaN;",
                  "    });",
                  "    pm.test(\"Es una meta nueva del sistema (distinta de la inicial)\", function () {",
                  "        pm.expect(data.source).to.eql(\"system\");",
                  "        pm.expect(data.set_by).to.eql(null);",
                  "        pm.expect(data.id).to.not.eql(pm.collectionVariables.get(\"goals_goal_initial_id\"));",
                  "    });",
                  "    // Valor esperado: Mifflin-St Jeor sobre el perfil ya editado.",
                  "    const v = (name) => pm.collectionVariables.get(\"goals_profile_\" + name);",
                  "    const weight = Number(v(\"weight_kg\"));",
                  "    const height = Number(v(\"height_cm\"));",
                  "    const days = Number(v(\"training_days\"));",
                  "    const objective = v(\"objective\");",
                  "    const [by, bm, bd] = v(\"birth_date\").split(\"-\").map(Number);",
                  "    const today = new Date();",
                  "    const month = today.getUTCMonth() + 1;",
                  "    let age = today.getUTCFullYear() - by;",
                  "    if (month < bm || (month === bm && today.getUTCDate() < bd)) { age--; }",
                  "    const base = 10 * weight + 6.25 * height - 5 * age;",
                  "    const bmr = v(\"gender\") === \"male\" ? base + 5 : base - 161;",
                  "    const factor = days <= 1 ? 1.2 : days <= 3 ? 1.375 : days <= 5 ? 1.55 : 1.725;",
                  "    const adjustment = { lose_fat: 0.8, maintain: 1.0, gain_muscle: 1.1 }[objective];",
                  "    const proteinPerKg = { lose_fat: 2.0, maintain: 1.6, gain_muscle: 1.8 }[objective];",
                  "    const kcal = bmr * factor * adjustment;",
                  "    const expected = {",
                  "        calories: Math.round(kcal),",
                  "        protein_g: Math.round(weight * proteinPerKg),",
                  "        fat_g: Math.round(kcal * 0.25 / 9)",
                  "    };",
                  "    pm.test(\"calories, protein_g y fat_g coinciden con el nuevo cálculo (± 1)\", function () {",
                  "        pm.expect(Math.abs(data.calories - expected.calories)).to.be.at.most(1);",
                  "        pm.expect(Math.abs(data.protein_g - expected.protein_g)).to.be.at.most(1);",
                  "        pm.expect(Math.abs(data.fat_g - expected.fat_g)).to.be.at.most(1);",
                  "    });",
                  "    pm.collectionVariables.set(\"goals_goal_current_id\", data.id);",
                  "}"
                ]
              }
            }
