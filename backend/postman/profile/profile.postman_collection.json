  "item": [
    {
      "name": "HU-03 Perfil",
      "description": "Alta, consulta y edición del perfil inicial (solo rol user).",
      "item": [
        {
          "name": "Consulta antes de crear",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "    // Fechas relativas a hoy (UTC) para que la carpeta funcione cualquier día.",
                  "    const today = new Date();",
                  "    const yearsAgo = function (years) {",
                  "        const date = new Date(Date.UTC(today.getUTCFullYear() - years, today.getUTCMonth(), today.getUTCDate()));",
                  "        return date.toISOString().slice(0, 10);",
                  "    };",
                  "    pm.collectionVariables.set(\"profile_birth_date\", yearsAgo(30));",
                  "    pm.collectionVariables.set(\"profile_new_birth_date\", yearsAgo(41));",
                  "    pm.collectionVariables.set(\"profile_minor_birth_date\", yearsAgo(17));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "    pm.test(\"Status 404\", function () {",
                  "        pm.response.to.have.status(404);",
                  "    });",
                  "    const body = pm.response.json();",
                  "    pm.test(\"Formato de error { error: { code, message, fields } }\", function () {",
                  "        pm.expect(body).to.have.all.keys(\"error\");",
                  "        pm.expect(body.error).to.have.all.keys(\"code\", \"message\", \"fields\");",
                  "        pm.expect(body.error.message).to.be.a(\"string\").and.not.empty;",
                  "        pm.expect(body.error.fields).to.be.an(\"object\");",
                  "    });",
                  "    pm.test(\"Código PROFILE_NOT_FOUND\", function () {",
                  "        pm.expect(body.error.code).to.eql(\"PROFILE_NOT_FOUND\");",
                  "    });",
                  "    pm.test(\"Sin errores por campo\", function () {",
                  "        pm.expect(body.error.fields).to.eql({});",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_access_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "me",
                "profile"
              ]
            },
            "description": "El usuario de HU-01 aún no tiene perfil → 404 PROFILE_NOT_FOUND. Prepara las fechas de nacimiento de la carpeta (relativas a hoy)."
