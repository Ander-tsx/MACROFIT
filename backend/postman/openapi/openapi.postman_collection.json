{
  "info": {
    "_postman_id": "5e1d7c2a-0b4f-4c3e-8a6d-1f2e3c4b0014",
    "name": "MacroFit · OpenAPI",
    "description": "Contrato de la API en OpenAPI (src/routes/openapi.rs).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TEC-14 Contrato OpenAPI",
      "description": "La especificación se genera desde el código (utoipa) y se publica con Swagger UI.",
      "item": [
        {
          "name": "Especificación OpenAPI",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "    pm.test('Status 200', function () {",
                  "        pm.response.to.have.status(200);",
                  "    });",
                  "    const spec = pm.response.json();",
                  "    pm.test('Es OpenAPI 3.1 de MacroFit con servidor /api/v1', function () {",
                  "        pm.expect(spec.openapi).to.match(/^3\\.1\\./);",
                  "        pm.expect(spec.info.title).to.eql('MacroFit API');",
                  "        pm.expect(spec.servers[0].url).to.eql('/api/v1');",
                  "    });",
                  "    // Catálogo de endpoints del README: método, ruta y rol ('' = cualquier sesión, null = pública).",
                  "    const catalog = [",
                  "        ['get', '/health', null], ['get', '/legal/privacy', null],",
                  "        ['post', '/auth/register', null], ['post', '/auth/login', null], ['post', '/auth/refresh', null],",
                  "        ['post', '/auth/logout', ''], ['get', '/auth/me', ''],",
                  "        ['post', '/users/me/profile', 'user'], ['get', '/users/me/profile', 'user'], ['patch', '/users/me/profile', 'user'],",
                  "        ['get', '/users/me/goals/current', 'user'], ['get', '/users/me/goals', 'user'],",
                  "        ['get', '/coach/clients', 'coach'], ['get', '/coach/clients/{clientId}/goals', 'coach'],",
                  "        ['post', '/coach/clients/{clientId}/goals', 'coach'], ['get', '/coach/invite-code', 'coach'],",
                  "        ['post', '/coach/invite-code/regenerate', 'coach'], ['get', '/coach/test', 'coach'],",
                  "        ['post', '/meals/photos', 'user'],",
                  "    ];",
                  "    pm.test('Incluye todos los endpoints del catálogo', function () {",
                  "        catalog.forEach(([method, route]) => {",
                  "            pm.expect(spec.paths, route).to.have.property(route);",
                  "            pm.expect(spec.paths[route], `${method} ${route}`).to.have.property(method);",
                  "        });",
                  "    });",
                  "    pm.test('Rutas protegidas con bearer_auth y su rol; públicas sin seguridad', function () {",
                  "        catalog.forEach(([method, route, role]) => {",
                  "            const security = spec.paths[route][method].security;",
                  "            if (role === null) {",
                  "                pm.expect(security, `${method} ${route}`).to.be.undefined;",
                  "            } else {",
                  "                pm.expect(security, `${method} ${route}`).to.eql([{ bearer_auth: role ? [role] : [] }]);",
                  "            }",
                  "        });",
                  "        const scheme = spec.components.securitySchemes.bearer_auth;",
                  "        pm.expect(scheme).to.include({ type: 'http', scheme: 'bearer', bearerFormat: 'JWT' });",
                  "    });",
                  "    pm.test('Formato de error definido una vez y usado por todas las respuestas de error', function () {",
                  "        pm.expect(spec.components.schemas.ErrorResponse.required).to.eql(['error']);",
                  "        pm.expect(spec.components.schemas.ErrorBody.required).to.eql(['code', 'message', 'fields']);",
                  "        Object.entries(spec.paths).forEach(([route, item]) => {",
                  "            Object.entries(item).forEach(([method, op]) => {",
                  "                Object.entries(op.responses || {}).filter(([status]) => Number(status) >= 400).forEach(([status, res]) => {",
                  "                    pm.expect(res.content['application/json'].schema.$ref, `${method} ${route} ${status}`)",
                  "                        .to.eql('#/components/schemas/ErrorResponse');",
                  "                });",
                  "            });",
                  "        });",
                  "    });",
                  "    pm.collectionVariables.set('openapi_has_dev', String(Object.keys(spec.paths).some((p) => p.startsWith('/dev'))));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/openapi.json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "openapi.json"
              ]
            },
            "description": "Especificación generada desde el código."
          },
          "response": []
        },
        {
          "name": "Rutas /dev según el ambiente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "    // Con APP_ENV=development la ruta existe (400 por el cuerpo vacío) y está documentada;",
                  "    // en otro ambiente no se monta (404) y tampoco aparece en la especificación.",
                  "    const documented = pm.collectionVariables.get('openapi_has_dev') === 'true';",
                  "    pm.test('Status 400 o 404', function () {",
                  "        pm.expect(pm.response.code).to.be.oneOf([400, 404]);",
                  "    });",
                  "    pm.test('La especificación documenta /dev solo si la ruta existe', function () {",
                  "        pm.expect(documented).to.eql(pm.response.code === 400);",
                  "    });",
                  "    if (pm.response.code === 400) {",
                  "        pm.test('Estructura de error VALIDATION_ERROR con los dos campos', function () {",
                  "            const body = pm.response.json();",
                  "            pm.expect(body).to.have.all.keys('error');",
                  "            pm.expect(body.error).to.have.all.keys('code', 'message', 'fields');",
                  "            pm.expect(body.error.code).to.eql('VALIDATION_ERROR');",
                  "            pm.expect(body.error.fields).to.have.all.keys('coach_id', 'user_id');",
                  "        });",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/dev/seed/coach-links",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "dev",
                "seed",
                "coach-links"
              ]
            },
            "description": "La ruta de datos de prueba solo existe (y solo se documenta) con APP_ENV=development."
          },
          "response": []
        },
        {
