        {
          "name": "Creación válida",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "    pm.test(\"Status 201\", function () {",
                  "        pm.response.to.have.status(201);",
                  "    });",
                  "    const data = pm.response.json();",
                  "    pm.test(\"Estructura: id, user_id, objective, level, training_days, weight_kg, height_cm, gender, birth_date, created_at, updated_at\", function () {",
                  "        pm.expect(data).to.have.all.keys(\"id\", \"user_id\", \"objective\", \"level\", \"training_days\", \"weight_kg\", \"height_cm\", \"gender\", \"birth_date\", \"created_at\", \"updated_at\");",
                  "        pm.expect(data.id).to.match(/^[0-9a-f]{24}$/);",
                  "        pm.expect(data.user_id).to.eql(pm.collectionVariables.get(\"user_id\"));",
                  "        pm.expect(data.birth_date).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
                  "        pm.expect(new Date(data.created_at).toString()).to.not.eql(\"Invalid Date\");",
                  "        pm.expect(new Date(data.updated_at).toString()).to.not.eql(\"Invalid Date\");",
                  "    });",
                  "    const sent = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
                  "    pm.test(\"Los valores devueltos son los enviados\", function () {",
                  "        [\"objective\",\"level\",\"training_days\",\"weight_kg\",\"height_cm\",\"gender\",\"birth_date\"].forEach(function (field) {",
                  "            pm.expect(data[field], field).to.eql(sent[field]);",
                  "        });",
                  "    });",
                  "    pm.collectionVariables.set(\"profile_id\", data.id);",
                  "    pm.collectionVariables.set(\"profile_sent\", JSON.stringify(sent));",
                  "}"
                ]
              }
            }
          ],
