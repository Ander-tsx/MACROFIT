        {
          "name": "01 - Foto JPEG válida",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "    pm.test(\"Status 201 Created\", function () {",
                  "        pm.response.to.have.status(201);",
                  "    });",
                  "    const data = pm.response.json();",
                  "    pm.test(\"Estructura: id, format, size_bytes\", function () {",
                  "        pm.expect(data).to.have.all.keys(\"id\", \"format\", \"size_bytes\");",
                  "        pm.expect(data.id).to.be.a(\"string\").and.to.match(/^[0-9a-f]{24}$/);",
                  "    });",
                  "    pm.test(\"Formato jpeg y tamaño del archivo (134 bytes)\", function () {",
                  "        pm.expect(data.format).to.eql(\"jpeg\");",
                  "        pm.expect(data.size_bytes).to.eql(134);",
                  "    });",
                  "    pm.collectionVariables.set(\"meal_photo_id\", data.id);",
                  "}"
                ]
              }
            }
          ],
