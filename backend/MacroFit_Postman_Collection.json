{
  "info": {
    "_postman_id": "b3e0d869-7c85-4871-9d22-macrofit0001",
    "name": "MacroFit Backend API",
    "description": "Colección plana para probar y ejecutar todas las peticiones con el Postman Collection Runner (Health, Auth, JWT, Roles).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "coach_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_email",
      "value": "usuario_test@macrofit.com",
      "type": "string"
    },
    {
      "key": "coach_email",
      "value": "coach_test@macrofit.com",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. GET Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Respuesta contiene 'API MacroFit OK'\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"API MacroFit OK\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Verifica que el servidor Axum esté activo."
      },
      "response": []
    },
    {
      "name": "2. POST Registro - Usuario Normal",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var ts = Date.now();",
              "pm.collectionVariables.set('user_email', 'user_' + ts + '@macrofit.com');"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "if (pm.response.code === 201) {",
              "    var data = pm.response.json();",
              "    pm.collectionVariables.set('jwt_token', data.token);",
              "    pm.test(\"Token JWT recibido\", function () {",
              "        pm.expect(data.token).to.be.a('string');",
              "        pm.expect(data.role).to.eql('User');",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Erick Usuario\",\n  \"email\": \"{{user_email}}\",\n  \"password\": \"PasswordSeguro123\",\n  \"role\": \"User\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        },
        "description": "Registra un nuevo usuario común y guarda su token en {{jwt_token}}."
      },
      "response": []
    },
    {
      "name": "3. POST Login - Usuario Normal",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "if (pm.response.code === 200) {",
              "    var data = pm.response.json();",
              "    pm.collectionVariables.set('jwt_token', data.token);",
              "    pm.test(\"Token JWT validado\", function () {",
              "        pm.expect(data.token).to.be.a('string');",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"PasswordSeguro123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        },
        "description": "Inicia sesión con el usuario recién registrado."
      },
      "response": []
    },
    {
      "name": "4. POST Registro - Coach (Entrenador)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var ts = Date.now();",
              "pm.collectionVariables.set('coach_email', 'coach_' + ts + '@macrofit.com');"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "if (pm.response.code === 201) {",
              "    var data = pm.response.json();",
              "    pm.collectionVariables.set('coach_token', data.token);",
              "    pm.test(\"Token de Coach recibido\", function () {",
              "        pm.expect(data.role).to.eql('Coach');",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
