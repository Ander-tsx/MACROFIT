          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "  pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "  });",
                  "  const data = pm.response.json();",
                  "  pm.test('Solo devuelve el nombre del coach', function () {",
                  "    pm.expect(data).to.have.all.keys('coach_name');",
                  "    pm.expect(data.coach_name).to.be.a('string').and.not.empty;",
                  "  });",
                  "  pm.collectionVariables.set('preview_coach_name', data.coach_name);",
                  "}"
                ]
              }
            }
          ]
